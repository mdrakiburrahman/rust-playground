{
  "platform": {
    "kind": "local",
    "compose_file": "projects/loadtest/compose.yaml",
    "compose_override_file": "projects/loadtest/compose.oat.yaml",
    "compose_project": "arrowcol-oat-historical-client",
    "compose_state_root": "out/arrowcol-oat/historical-client",
    "local": {
      "collector_memory_limit_bytes": 4294967296
    }
  },
  "warmup_seconds": 60,
  "measure_seconds": 150,
  "pilot_mode": false,
  "client_ready_timeout_seconds": 600,
  "run_pin_ttl_ms": 3600000,
  "namespace": "arrowcol-oat",
  "arrowcol_deployment": "arrowcol",
  "arrowcol_container": "dataflow",
  "dfe_deployment": "arrowcol",
  "dfe_container": "dataflow",
  "arrowcol_pod_selector": "app=arrowcol",
  "dfe_pod_selector": "app=arrowcol",
  "arrowcol_endpoint": "http://router:50050",
  "router_metrics_endpoint": "http://127.0.0.1:15050/metrics",
  "edge_secret_file": "/run/secrets/edge-hmac",
  "tables": ["sqlserver_availability_replica_states"],
  "rows_per_table": 8192,
  "clients_per_table": 1,
  "qap_endpoint": "http://127.0.0.1:8080",
  "qap_timeout_seconds": 60,
  "replica_counts": [1],
  "dfe_worker_concurrency": [2],
  "result_url": "file:///tmp/arrowcol-oat-historical-client/results.parquet",
  "website_url": "file:///tmp/arrowcol-oat-historical-client/site/results.parquet",
  "tunables": {
    "client": {
      "payload_customer_id": "direct-e64-confirmwide",
      "corpus_rows": 65536,
      "batch_rows": 65536,
      "workers": 8,
      "runtime_threads": 12,
      "data_profile": "diagnostic",
      "max_memory_bytes": 1073741824,
      "interval_us": 0,
      "streams_per_worker": 2
    },
    "router": {
      "sql_pool_max_size": 64,
      "sql_pool_acquire_timeout_ms": 10000
    },
    "transport": {
      "ipc_compression": "none",
      "grpc_send_compression": "none",
      "max_flight_data_bytes": 67108864,
      "max_message_bytes": 134217728
    },
    "collector": {
      "cpu_pressure": "process",
      "batching": {
        "coalesce_publications": true,
        "max_age": "1s",
        "max_concurrent_flushes": 2
      },
      "runtime": {
        "workers": 4,
        "blocking_workers": 64,
        "upload_limit": 8,
        "task_limit": 128,
        "read_ahead": 8,
        "batch_rows": 16384,
        "cpu_workers": 4
      }
    },
    "parquet_writer": {
      "defaults": {
        "compression": "zstd",
        "compression_level": 3
      },
      "max_row_group_rows": 16384
    },
    "maintenance": {
      "enabled": true,
      "operations": ["optimize", "checkpoint"],
      "apply": false,
      "interval_secs": 60,
      "target_file_mib": 128
    }
  }
}
