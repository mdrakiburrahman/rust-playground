{
  "name": "rust",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "implicitDependencies": [
    "arrowcol-buffer",
    "arrowcol-receipts",
    "arrowcol-catalog",
    "arrowcol-protocol",
    "arrowcol-flight",
    "arrowcol-routing",
    "arrowcol-sql-server",
    "arrowcol-dataflow-components",
    "arrowcol-dataflow-rust",
    "arrowcol-router-rust",
    "kusto-bridge",
    "kusto-explorer",
    "arrowcol-rust",
    "arrowcol-sdk-gen",
    "arrow-deltalake",
    "arrow-tenant-stream",
    "otel-deltalake-exporter",
    "otelcol-rust",
    "greeting",
    "hello-world",
    "quiver-cli",
    "loadtest"
  ],
  "metadata": {
    "description": "Aggregate targets for the Rust workspace."
  },
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": [
            "arrowcol-buffer",
            "arrowcol-receipts",
            "arrowcol-catalog",
            "arrowcol-protocol",
            "arrowcol-flight",
            "arrowcol-routing",
            "arrowcol-sql-server",
            "arrowcol-dataflow-components",
            "arrowcol-dataflow-rust",
            "arrowcol-router-rust",
            "kusto-bridge",
            "kusto-explorer",
            "arrowcol-rust",
            "arrowcol-sdk-gen",
            "arrow-deltalake",
            "arrow-tenant-stream",
            "otel-deltalake-exporter",
            "otelcol-rust",
            "greeting",
            "hello-world",
            "quiver-cli",
            "loadtest",
            "auth-automation",
            "arrowcol-sdk-gen-tool",
            "rust-playground-build",
            "tools-scripts",
            "devcontainer"
          ],
          "target": "clean"
        }
      ],
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/clean.ts .",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      },
      "metadata": {
        "description": "Clean all projects' temporary state without removing managed caches or build artifacts."
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": [
            "arrowcol-buffer",
            "arrowcol-receipts",
            "arrowcol-catalog",
            "arrowcol-protocol",
            "arrowcol-flight",
            "arrowcol-routing",
            "arrowcol-sql-server",
            "arrowcol-dataflow-components",
            "arrowcol-dataflow-rust",
            "arrowcol-router-rust",
            "kusto-bridge",
            "kusto-explorer",
            "arrowcol-rust",
            "arrowcol-sdk-gen",
            "arrow-deltalake",
            "arrow-tenant-stream",
            "otel-deltalake-exporter",
            "otelcol-rust",
            "greeting",
            "hello-world",
            "quiver-cli",
            "loadtest"
          ],
          "target": "format"
        }
      ],
      "options": {
        "commands": []
      },
      "metadata": {
        "description": "Format every Rust package through its Nx project."
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": [
            "arrowcol-buffer",
            "arrowcol-receipts",
            "arrowcol-catalog",
            "arrowcol-protocol",
            "arrowcol-flight",
            "arrowcol-routing",
            "arrowcol-sql-server",
            "arrowcol-dataflow-components",
            "arrowcol-dataflow-rust",
            "arrowcol-router-rust",
            "kusto-bridge",
            "kusto-explorer",
            "arrowcol-rust",
            "arrowcol-sdk-gen",
            "arrow-deltalake",
            "arrow-tenant-stream",
            "otel-deltalake-exporter",
            "otelcol-rust",
            "greeting",
            "hello-world",
            "quiver-cli",
            "loadtest"
          ],
          "target": "format-check"
        }
      ],
      "options": {
        "commands": []
      },
      "metadata": {
        "description": "Check formatting for every Rust package through its Nx project."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": [
            "tools-scripts"
          ],
          "target": "markdown-lint"
        },
        {
          "projects": [
            "arrowcol-buffer",
            "arrowcol-receipts",
            "arrowcol-catalog",
            "arrowcol-protocol",
            "arrowcol-flight",
            "arrowcol-routing",
            "arrowcol-sql-server",
            "arrowcol-dataflow-components",
            "arrowcol-dataflow-rust",
            "arrowcol-router-rust",
            "kusto-bridge",
            "kusto-explorer",
            "arrowcol-rust",
            "arrowcol-sdk-gen",
            "arrow-deltalake",
            "arrow-tenant-stream",
            "otel-deltalake-exporter",
            "otelcol-rust",
            "greeting",
            "hello-world",
            "quiver-cli",
            "loadtest"
          ],
          "target": "lint"
        }
      ],
      "options": {
        "commands": []
      },
      "metadata": {
        "description": "Lint first-party Markdown and run strict Clippy checks for every Rust package."
      }
    },
    "fail-on-untracked-files": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": [
            "tools-scripts"
          ],
          "target": "clean-worktree"
        }
      ],
      "options": {
        "commands": []
      },
      "metadata": {
        "description": "Reject tracked changes and unexpected untracked files after verification."
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": [
            "arrowcol-buffer",
            "arrowcol-receipts",
            "arrowcol-catalog",
            "arrowcol-protocol",
            "arrowcol-flight",
            "arrowcol-routing",
            "arrowcol-sql-server",
            "arrowcol-dataflow-components",
            "arrowcol-dataflow-rust",
            "arrowcol-router-rust",
            "kusto-bridge",
            "kusto-explorer",
            "arrowcol-rust",
            "arrowcol-sdk-gen",
            "arrow-deltalake",
            "arrow-tenant-stream",
            "otel-deltalake-exporter",
            "otelcol-rust",
            "greeting",
            "hello-world",
            "quiver-cli"
          ],
          "target": "build"
        },
        {
          "projects": [
            "loadtest"
          ],
          "target": "reader-build"
        }
      ],
      "options": {
        "commands": []
      },
      "metadata": {
        "description": "Build every Rust package through its Nx project."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": [
            "arrowcol-buffer",
            "arrowcol-receipts",
            "arrowcol-catalog",
            "arrowcol-protocol",
            "arrowcol-flight",
            "arrowcol-routing",
            "arrowcol-sql-server",
            "arrowcol-dataflow-components",
            "arrowcol-dataflow-rust",
            "arrowcol-router-rust",
            "kusto-bridge",
            "kusto-explorer",
            "arrowcol-rust",
            "arrowcol-sdk-gen",
            "arrow-deltalake",
            "arrow-tenant-stream",
            "otel-deltalake-exporter",
            "otelcol-rust",
            "greeting",
            "hello-world",
            "quiver-cli",
            "loadtest"
          ],
          "target": "test"
        }
      ],
      "options": {
        "commands": []
      },
      "metadata": {
        "description": "Run package tests without duplicating workspace doc-tests."
      }
    },
    "lockfile-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/crates/*/Cargo.toml",
        "{workspaceRoot}/bin/*/Cargo.toml",
        "{workspaceRoot}/projects/arrowcol-dataflow-rust/Cargo.toml",
        "{workspaceRoot}/projects/loadtest/loadgen/Cargo.toml",
        "{workspaceRoot}/projects/loadtest/reader/Cargo.toml",
        "{workspaceRoot}/projects/arrowcol-rust/Cargo.toml",
        "{workspaceRoot}/projects/otelcol-rust/Cargo.toml",
        "{workspaceRoot}/projects/kusto-explorer/Cargo.toml",
        "{workspaceRoot}/projects/kusto-bridge/Cargo.toml",
        "{workspaceRoot}/projects/kusto-explorer/api/Cargo.toml",
        "{workspaceRoot}/projects/kusto-explorer/ui/Cargo.toml",
        "{workspaceRoot}/submodules/otel-arrow/rust/otap-dataflow/**/Cargo.toml"
      ],
      "options": {
        "command": "cargo tree --locked --workspace --depth 0",
        "cwd": "."
      },
      "metadata": {
        "description": "Verify that workspace metadata resolves without changing Cargo.lock."
      }
    },
    "doc-test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml",
        "{workspaceRoot}/crates/*/Cargo.toml",
        "{workspaceRoot}/crates/*/src/**/*",
        "{workspaceRoot}/bin/*/Cargo.toml",
        "{workspaceRoot}/bin/*/src/**/*",
        "{workspaceRoot}/projects/arrowcol-dataflow-rust/Cargo.toml",
        "{workspaceRoot}/projects/arrowcol-dataflow-rust/src/**/*",
        "{workspaceRoot}/projects/loadtest/loadgen/Cargo.toml",
        "{workspaceRoot}/projects/loadtest/loadgen/src/**/*",
        "{workspaceRoot}/projects/loadtest/reader/Cargo.toml",
        "{workspaceRoot}/projects/loadtest/reader/src/**/*",
        "{workspaceRoot}/projects/arrowcol-rust/Cargo.toml",
        "{workspaceRoot}/projects/arrowcol-rust/src/**/*",
        "{workspaceRoot}/projects/otelcol-rust/Cargo.toml",
        "{workspaceRoot}/projects/otelcol-rust/src/**/*",
        "{workspaceRoot}/projects/kusto-explorer/Cargo.toml",
        "{workspaceRoot}/projects/kusto-bridge/Cargo.toml",
        "{workspaceRoot}/projects/kusto-bridge/src/**/*",
        "{workspaceRoot}/projects/kusto-explorer/src/**/*",
        "{workspaceRoot}/projects/kusto-explorer/api/Cargo.toml",
        "{workspaceRoot}/projects/kusto-explorer/api/src/**/*",
        "{workspaceRoot}/projects/kusto-explorer/ui/Cargo.toml",
        "{workspaceRoot}/projects/kusto-explorer/ui/src/**/*",
        "{workspaceRoot}/submodules/otel-arrow/rust/otap-dataflow/**/*.rs",
        "{workspaceRoot}/submodules/otel-arrow/rust/otap-dataflow/**/Cargo.toml"
      ],
      "options": {
        "command": "cargo test --locked --workspace --doc --all-features",
        "cwd": "."
      },
      "metadata": {
        "description": "Run workspace doc-tests once."
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "format-check",
        "lint",
        "build",
        "test",
        "lockfile-check",
        "doc-test"
      ],
      "options": {
        "commands": []
      },
      "metadata": {
        "description": "Run all package checks plus workspace-only Rust checks."
      }
    }
  },
  "tags": [
    "scope:rust",
    "type:aggregate"
  ]
}
