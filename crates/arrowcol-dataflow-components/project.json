{
  "name": "arrowcol-dataflow-components",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "crates/arrowcol-dataflow-components/src",
  "implicitDependencies": [
    "arrowcol-flight",
    "arrowcol-catalog",
    "arrowcol-routing",
    "arrowcol-protocol",
    "arrow-deltalake"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/submodules/otel-arrow/rust/otap-dataflow/crates/{config,core-nodes,engine,otap,pdata,quiver}/**/*"
    ]
  },
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/clean.ts crates/arrowcol-dataflow-components",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt --package arrowcol-dataflow-components"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt --package arrowcol-dataflow-components -- --check"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy --locked --package arrowcol-dataflow-components --all-targets -- -D warnings"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo build --locked --package arrowcol-dataflow-components"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --locked --package arrowcol-dataflow-components"
      }
    },
    "doc": {
      "executor": "nx:run-commands",
      "options": {
        "command": "RUSTDOCFLAGS='-D warnings' cargo doc --locked --package arrowcol-dataflow-components --no-deps"
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "dependsOn": ["format-check", "lint", "build", "test", "doc"],
      "options": {
        "commands": []
      }
    }
  },
  "tags": ["scope:rust", "type:library"]
}
