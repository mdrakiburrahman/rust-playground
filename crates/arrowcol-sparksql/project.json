{
  "name": "arrowcol-sparksql",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "crates/arrowcol-sparksql/src",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "{workspaceRoot}/Cargo.toml", "{workspaceRoot}/Cargo.lock", "{workspaceRoot}/rust-toolchain.toml"]
  },
  "targets": {
    "format": { "executor": "nx:run-commands", "options": { "command": "cargo fmt --package arrowcol-sparksql" } },
    "format-check": { "executor": "nx:run-commands", "options": { "command": "cargo fmt --package arrowcol-sparksql -- --check" } },
    "lint": { "executor": "nx:run-commands", "options": { "command": "cargo clippy --locked --package arrowcol-sparksql --all-targets -- -D warnings" } },
    "build": { "executor": "nx:run-commands", "options": { "command": "cargo build --locked --package arrowcol-sparksql" } },
    "test": { "executor": "nx:run-commands", "options": { "command": "cargo test --locked --package arrowcol-sparksql" } },
    "doc": { "executor": "nx:run-commands", "options": { "command": "RUSTDOCFLAGS='-D warnings' cargo doc --locked --package arrowcol-sparksql --no-deps" } },
    "verify": { "executor": "nx:run-commands", "dependsOn": ["format-check", "lint", "build", "test", "doc"], "options": { "commands": [] } }
  },
  "tags": ["scope:rust", "type:library"]
}
