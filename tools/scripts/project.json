{
  "name": "tools-scripts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "tools/scripts/src",
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/clean.ts tools/scripts",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx --no-install tsc --project tools/scripts/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx --no-install tsx --test tools/scripts/test/**/*.test.ts"
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "typecheck",
        "test"
      ],
      "options": {
        "commands": []
      }
    },
    "clean-worktree": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/verify-clean-worktree.ts",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "markdown-lint": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "python3 -B -m unittest discover -s docs -p test_validate.py",
          "python3 docs/validate.py",
          "npx --no-install markdownlint-cli2"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "markdown-lint-fix": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install markdownlint-cli2 --fix",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "ci-prepare": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/ci.ts prepare",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "ci-plan": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/ci-plan.ts",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "ci-build-environment": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/ci.ts build-environment",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "ci-environment-key": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/ci.ts environment-key",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "ci-start-artifact": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/ci.ts start-artifact",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "ci-verify-host": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/ci.ts verify-host",
