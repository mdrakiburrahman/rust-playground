{
  "name": "tools-scripts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "tools/scripts/src",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx --no-install tsc --project tools/scripts/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx --no-install tsx --test tools/scripts/test/**/*.test.ts"
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "typecheck",
        "test"
      ],
      "options": {
        "commands": []
      }
    },
    "clean-worktree": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/verify-clean-worktree.ts",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "ci-prepare": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/ci.ts prepare",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "ci-start-source": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/ci.ts start-source",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "ci-start-published": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/ci.ts start-published",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "ci-verify": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/ci.ts verify",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "ci-cleanup": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/ci.ts cleanup",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "registry-login": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/registry.ts login",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": true
      }
    },
    "registry-tags": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/registry.ts tags",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": true
      }
    },
    "registry-manifest": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/registry.ts manifest",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": true
      }
    },
    "registry-public": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/registry.ts public",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": true
      }
    }
  },
  "tags": [
    "scope:tools"
  ]
}
