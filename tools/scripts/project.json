    "ci-verify": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/ci.ts verify",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "ci-cleanup": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/ci.ts cleanup",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "registry-login": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/registry.ts login",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": true
      }
    },
    "registry-tags": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
