        "forwardAllArgs": true
      }
    },
    "registry-public": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/registry.ts public",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": true
      }
    },
    "image-publish-plan": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/image-plan.ts",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    }
  },
  "tags": [
    "scope:tools"
  ]
}
