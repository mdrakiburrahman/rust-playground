        "forwardAllArgs": false
      }
    },
    "ci-import-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/ci.ts import-integration",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "ci-start-source": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
