{
  "name": "rust-playground",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "runServices": [
    "workspace"
  ],
  "workspaceFolder": "/workspaces/rust-playground",
  "shutdownAction": "stopCompose",
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "initializeCommand": [
    "node",
    ".devcontainer/scripts/initialize.ts"
  ],
  "postCreateCommand": [
    "node",
    ".devcontainer/scripts/post-create.ts"
  ],
  "postStartCommand": [
    "node",
    ".devcontainer/scripts/post-create.ts",
    "--permissions-only"
  ],
  "waitFor": "postStartCommand",
  "portsAttributes": {
    "14333": {
      "label": "SQL Server (loadtest; published on the Docker host, reached via WSL localhost)",
      "onAutoForward": "ignore"
    },
    "3000": {
      "label": "Grafana (loadtest; published on the Docker host, reached via WSL localhost)",
      "onAutoForward": "ignore"
    },
    "9444": {
      "label": "Portainer (loadtest; published on the Docker host, reached via WSL localhost)",
      "onAutoForward": "ignore"
    },
    "8080": {
      "label": "Kusto emulator (loadtest; published on the Docker host, reached via WSL localhost)",
      "onAutoForward": "ignore"
    },
    "8090": {
      "label": "kusto-explorer UI (loadtest; published on the Docker host, reached via WSL localhost)",
      "onAutoForward": "ignore"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "files.watcherExclude": {
          "**/.git/objects/**": true,
          "**/.nx/**": true,
          "**/node_modules/**": true,
          "**/target/**": true
        },
        "remote.forwardOnOpen": false,
        "rust-analyzer.check.command": "clippy",
        "terminal.integrated.defaultProfile.linux": "bash",
        "workbench.browser.enableRemoteProxy": false
      }
    }
  }
}
