{
  "name": "devcontainer",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "tag": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node .devcontainer/scripts/content-hash.ts --write",
        "cwd": "."
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "tag",
        "scripts-test"
      ],
      "options": {
        "command": "node .devcontainer/scripts/build.ts",
        "cwd": "."
      }
    },
    "up": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install devcontainer up --workspace-folder . --config .devcontainer/devcontainer.json",
        "cwd": "."
      }
    },
    "up-source": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install devcontainer up --workspace-folder . --config .devcontainer/devcontainer.local.json --frozen-lockfile",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "up",
        "scripts-test"
      ],
      "options": {
        "command": "npx --no-install devcontainer exec --workspace-folder . --config .devcontainer/devcontainer.json bash -lc \"npm exec -- nx run-many -t verify --all\"",
        "cwd": "."
      }
    },
    "test-source": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "up-source",
        "scripts-test"
      ],
      "options": {
        "command": "npx --no-install devcontainer exec --workspace-folder . --config .devcontainer/devcontainer.local.json bash -lc \"npm exec -- nx run-many -t verify --all\"",
        "cwd": "."
      }
    },
    "scripts-typecheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsc --project .devcontainer/tsconfig.json",
        "cwd": "."
      }
    },
    "scripts-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "scripts-typecheck"
      ],
      "options": {
        "command": "node --test .devcontainer/test/devcontainer.test.ts",
        "cwd": "."
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "scripts-test"
      ],
      "options": {
        "command": "node .devcontainer/scripts/content-hash.ts --check",
        "cwd": "."
      }
    },
    "down": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node .devcontainer/scripts/down.ts",
        "cwd": "."
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "tag",
        "scripts-test"
      ],
      "options": {
        "command": "node .devcontainer/scripts/publish.ts",
        "cwd": "."
      }
    }
  }
}
