{
  "name": "rust-playground (source)",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "../docker-compose.local.yml"
  ],
  "service": "workspace",
  "runServices": [
    "workspace"
  ],
  "workspaceFolder": "/workspaces/rust-playground",
  "shutdownAction": "stopCompose",
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "initializeCommand": [
    "node",
    ".devcontainer/scripts/initialize.ts"
  ],
  "onCreateCommand": [
    "az",
    "extension",
    "add",
    "--name",
    "aks-preview",
    "--version",
    "22.0.0b15",
    "--yes",
    "--only-show-errors"
  ],
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "1.96.1",
      "profile": "minimal",
      "components": "rustfmt,clippy"
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "moby": true,
      "dockerDashComposeVersion": "v2",
      "installDockerBuildx": true
    }
  },
  "postCreateCommand": [
    "node",
    ".devcontainer/scripts/post-create.ts"
  ],
  "postStartCommand": [
    "node",
    ".devcontainer/scripts/post-create.ts",
    "--permissions-only"
  ],
  "waitFor": "postStartCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "files.watcherExclude": {
          "**/.git/objects/**": true,
          "**/.nx/**": true,
          "**/node_modules/**": true,
          "**/target/**": true
        },
        "remote.forwardOnOpen": false,
        "rust-analyzer.check.command": "clippy",
        "terminal.integrated.defaultProfile.linux": "bash",
        "workbench.browser.enableRemoteProxy": false
      }
    }
  }
}
