COMPOSE_PROJECT_NAME=arrowcol-infra

# Host bindings are loopback-only in compose.yaml.
SQLSERVER_PORT=14333

# Local Docker secret sources. Run ./scripts/bootstrap-secrets.sh to create
# these files with mode 0600; never put password values in this file.
SQLSERVER_SA_PASSWORD_FILE=./secrets/sqlserver-sa-password.txt
ARROWCOL_APP_PASSWORD_FILE=./secrets/arrowcol-app-password.txt
ARROWCOL_MIGRATOR_PASSWORD_FILE=./secrets/arrowcol-migrator-password.txt

SQLSERVER_MEMORY_LIMIT_MB=2048
STACK_WAIT_SECONDS=600
STACK_STOP_SECONDS=30
