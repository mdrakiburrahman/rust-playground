{
  "name": "arrowcol-rust",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "projects/arrowcol-rust/src",
  "implicitDependencies": [
    "arrowcol-buffer",
    "arrowcol-receipts",
    "arrowcol-catalog",
    "arrowcol-protocol",
    "arrowcol-flight",
    "arrowcol-routing",
    "arrowcol-sql-server",
    "arrow-deltalake",
    "arrowcol-infra"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/.data/**/*",
      "!{projectRoot}/.diagnostics/**/*",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/projects/arrowcol-infra/migrations/**/*"
    ]
  },
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/clean.ts projects/arrowcol-rust",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt --package arrowcol-rust"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt --package arrowcol-rust -- --check"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy --locked --package arrowcol-rust --all-targets -- -D warnings"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo build --locked --package arrowcol-rust"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --locked --package arrowcol-rust"
      }
    },
    "doc": {
      "executor": "nx:run-commands",
      "options": {
        "command": "RUSTDOCFLAGS='-D warnings' cargo doc --locked --package arrowcol-rust --no-deps"
      }
    },
    "config-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "build"
      ],
      "options": {
        "commands": [
          "target/debug/arrowcol-rust --validate-and-exit --config projects/arrowcol-rust/config.yaml",
          "target/debug/arrowcol-rust --validate-and-exit --config projects/arrowcol-rust/config.docker.yaml"
        ],
        "parallel": false
      }
    },
    "image": {
      "executor": "rust-playground-build:docker-build",
      "cache": false,
      "inputs": [
        "default",
        "^default",
        "{projectRoot}/Dockerfile",
        "{workspaceRoot}/.dockerignore",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml",
        "{workspaceRoot}/submodules/otel-arrow/**/*"
      ],
      "outputs": [
        "{workspaceRoot}/target/images/arrowcol-rust-load.txt"
      ],
      "options": {
        "file": "{absProjectRoot}/Dockerfile",
        "context": "{absWorkspaceRoot}",
        "image": "ghcr.io/mdrakiburrahman/rust-playground/arrowcol-rust",
        "tags": ["dev"],
        "buildArgs": ["VCS_REF={gitSha}"],
        "requireCleanWorktree": true,
        "platforms": ["linux/amd64"],
        "output": "load",
        "manifestFile": "{absWorkspaceRoot}/target/images/arrowcol-rust-load.txt"
      },
      "configurations": {
        "ci-verify": {
          "cacheFrom": ["type=gha,version=2,scope={projectName}-image"],
          "cacheTo": ["type=gha,version=2,scope={projectName}-image,mode=max"]
        }
      }
    },
    "image-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["image"],
      "options": {
        "command": "bash projects/arrowcol-rust/scripts/image-smoke.sh",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "publish": {
      "executor": "rust-playground-build:docker-build",
      "cache": false,
      "inputs": [
        "default",
        "^default",
        "{projectRoot}/Dockerfile",
        "{workspaceRoot}/.dockerignore",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml",
        "{workspaceRoot}/submodules/otel-arrow/**/*"
      ],
      "outputs": [
        "{workspaceRoot}/target/images/arrowcol-rust-publish.txt"
      ],
      "options": {
        "file": "{absProjectRoot}/Dockerfile",
        "context": "{absWorkspaceRoot}",
        "image": "ghcr.io/mdrakiburrahman/rust-playground/arrowcol-rust",
        "tags": ["{gitBranchTag}", "sha-{gitSha}"],
        "immutableTags": ["sha-{gitSha}"],
        "requireCleanWorktree": true,
        "buildArgs": ["VCS_REF={gitSha}"],
        "platforms": ["linux/amd64"],
        "output": "push",
        "manifestFile": "{absWorkspaceRoot}/target/images/arrowcol-rust-publish.txt"
      },
      "configurations": {
        "main": {
          "tags": ["{gitBranchTag}", "sha-{gitSha}", "latest"]
        }
      }
    },
    "live-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "projects/arrowcol-rust/scripts/live-e2e.sh",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "config-check",
        "format-check",
        "lint",
        "test",
        "doc"
      ],
      "options": {
        "commands": []
      }
    }
  },
  "tags": [
    "scope:rust",
    "type:application",
    "type:runtime-image"
  ]
}
