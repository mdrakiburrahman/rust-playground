{
  "name": "arrowcol-oat-rust",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "projects/arrowcol-oat-rust/src",
  "implicitDependencies": ["arrow-deltalake", "collector-chain"],
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {"command": "cargo fmt --package arrowcol-oat-rust"}
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {"command": "cargo fmt --package arrowcol-oat-rust -- --check"}
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {"command": "cargo clippy --locked --package arrowcol-oat-rust --all-targets -- -D warnings"}
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {"command": "cargo test --locked --package arrowcol-oat-rust"}
    },
    "startup-readback-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "parallel": false,
        "commands": [
          "cargo build --locked --package collector-chain --bin arrowcol-dmv",
          "cargo build --locked --package arrowcol-router-rust",
          "cargo build --locked --package arrowcol-dataflow-rust",
          "cargo test --locked --package arrowcol-oat-rust --lib client_leaf_adapters_use_actual_consumer_startup -- --ignored",
          "cargo test --locked --package arrowcol-oat-rust --lib router_excluded_gauges_reach_actual_startup_readback -- --ignored",
          "cargo test --locked --package arrowcol-oat-rust --lib upload_only_reaches_actual_collector_startup -- --ignored",
          "cargo test --locked --package arrowcol-oat-rust --lib parquet_policy_reaches_actual_collector_startup -- --ignored",
          "cargo test --locked --package arrowcol-oat-rust --lib commit_and_pressure_reach_actual_collector_startup -- --ignored"
        ]
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {"command": "cargo build --locked --package arrowcol-oat-rust"}
    },
    "run": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo run --locked --package arrowcol-oat-rust --bin arrowcol-oat-rust",
        "forwardAllArgs": true
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build", "format-check", "lint", "test", "startup-readback-test"],
      "options": {"commands": []}
    }
  }
}
