# syntax=docker/dockerfile:1.7

ARG VCS_REF=local
ARG OAT_CLIENT_BUILD_PROFILE_HASH=none
FROM rust:1.96.1-bookworm@sha256:a339861ae23e9abb272cea45dfafde21760d2ce6577a70f8a926153677902663 AS builder
ARG OAT_CLIENT_BUILD_LTO=off
ARG OAT_CLIENT_BUILD_CODEGEN_UNITS=16
ARG OAT_CLIENT_BUILD_OPT_LEVEL=3
ARG OAT_CLIENT_BUILD_TARGET_CPU=generic
RUN apt-get update \
    && apt-get install -y --no-install-recommends cmake protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY Cargo.toml Cargo.lock rust-toolchain.toml rustfmt.toml /workspace/
COPY crates /workspace/crates
COPY bin /workspace/bin
COPY projects /workspace/projects
COPY docs/experiments/arrowcol-oat/oat-config.quick.json /workspace/docs/experiments/arrowcol-oat/oat-config.quick.json
COPY submodules/otel-arrow /workspace/submodules/otel-arrow
RUN --mount=type=cache,id=rust-playground-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=rust-playground-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=rust-playground-target-oat-client-${OAT_CLIENT_BUILD_LTO}-${OAT_CLIENT_BUILD_CODEGEN_UNITS}-${OAT_CLIENT_BUILD_OPT_LEVEL}-${OAT_CLIENT_BUILD_TARGET_CPU},target=/workspace/target,sharing=locked \
    set -eu; \
    case "${OAT_CLIENT_BUILD_LTO}" in off|thin-local|thin|fat) ;; *) echo 'invalid OAT_CLIENT_BUILD_LTO' >&2; exit 2 ;; esac; \
    case "${OAT_CLIENT_BUILD_CODEGEN_UNITS}" in ''|*[!0-9]*) echo 'invalid OAT_CLIENT_BUILD_CODEGEN_UNITS' >&2; exit 2 ;; esac; \
    [ "${OAT_CLIENT_BUILD_CODEGEN_UNITS}" -ge 1 ] && [ "${OAT_CLIENT_BUILD_CODEGEN_UNITS}" -le 256 ] || { echo 'invalid OAT_CLIENT_BUILD_CODEGEN_UNITS' >&2; exit 2; }; \
    case "${OAT_CLIENT_BUILD_OPT_LEVEL}" in 2|3) ;; *) echo 'invalid OAT_CLIENT_BUILD_OPT_LEVEL' >&2; exit 2 ;; esac; \
    case "${OAT_CLIENT_BUILD_TARGET_CPU}" in generic|x86-64-v2|x86-64-v3|x86-64-v4) ;; *) echo 'invalid OAT_CLIENT_BUILD_TARGET_CPU' >&2; exit 2 ;; esac; \
    export ARROWCOL_OAT_CLIENT_BUILD_LTO=${OAT_CLIENT_BUILD_LTO} ARROWCOL_OAT_CLIENT_BUILD_CODEGEN_UNITS=${OAT_CLIENT_BUILD_CODEGEN_UNITS}; \
    export ARROWCOL_OAT_CLIENT_BUILD_OPT_LEVEL=${OAT_CLIENT_BUILD_OPT_LEVEL} ARROWCOL_OAT_CLIENT_BUILD_TARGET_CPU=${OAT_CLIENT_BUILD_TARGET_CPU}; \
    case "${OAT_CLIENT_BUILD_LTO}" in off) export CARGO_PROFILE_RELEASE_LTO=off ;; thin-local) export CARGO_PROFILE_RELEASE_LTO=false ;; thin|fat) export CARGO_PROFILE_RELEASE_LTO=${OAT_CLIENT_BUILD_LTO} ;; esac; \
    export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=${OAT_CLIENT_BUILD_CODEGEN_UNITS}; \
    export CARGO_PROFILE_RELEASE_OPT_LEVEL=${OAT_CLIENT_BUILD_OPT_LEVEL}; \
    if [ "${OAT_CLIENT_BUILD_TARGET_CPU}" != generic ]; then export RUSTFLAGS="${RUSTFLAGS:+${RUSTFLAGS} }-C target-cpu=${OAT_CLIENT_BUILD_TARGET_CPU}"; fi; \
    CARGO_TARGET_DIR=/workspace/target cargo build --locked --release \
      --package collector-chain --bin arrowcol-dmv \
      --package arrowcol-oat-rust --bin arrowcol-oat-pin-init \
    && install --mode=0555 /workspace/target/release/arrowcol-dmv /usr/local/bin/arrowcol-dmv \
    && install --mode=0555 /workspace/target/release/arrowcol-oat-pin-init /usr/local/bin/arrowcol-oat-pin-init \
    && strip /usr/local/bin/arrowcol-dmv \
    && strip /usr/local/bin/arrowcol-oat-pin-init

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
ARG VCS_REF
ARG OAT_CLIENT_BUILD_PROFILE_HASH
LABEL org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.profile="${OAT_CLIENT_BUILD_PROFILE_HASH}"
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --no-create-home --no-log-init --home-dir /nonexistent --shell /usr/sbin/nologin app
COPY --from=builder --chmod=0555 /usr/local/bin/arrowcol-dmv /usr/local/bin/arrowcol-dmv
COPY --from=builder --chmod=0555 /usr/local/bin/arrowcol-oat-pin-init /usr/local/bin/arrowcol-oat-pin-init
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/arrowcol-dmv"]
