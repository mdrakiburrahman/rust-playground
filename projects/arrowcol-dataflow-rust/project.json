{
  "name": "arrowcol-dataflow-rust",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "projects/arrowcol-dataflow-rust/src",
  "implicitDependencies": [
    "arrowcol-dataflow-components",
    "arrowcol-infra"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/.diagnostics/**/*",
      "!{projectRoot}/.temp/**/*",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/projects/arrowcol-infra/migrations/**/*"
    ]
  },
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/clean.ts projects/arrowcol-dataflow-rust",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo build --locked --package arrowcol-dataflow-rust"
      }
    },
    "config-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "projects/arrowcol-dataflow-rust/scripts/config-check.sh",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "target/debug/arrowcol-dataflow-rust --num-cores 1 --config projects/arrowcol-dataflow-rust/config.yaml",
        "forwardAllArgs": true
      }
    },
    "run-quiver": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "target/debug/arrowcol-dataflow-rust --num-cores 1 --config projects/arrowcol-dataflow-rust/config.quiver.yaml",
        "forwardAllArgs": true
      }
    },
    "image": {
      "executor": "rust-playground-build:docker-build",
      "cache": false,
      "inputs": [
        "default",
        "^default",
        "{projectRoot}/Dockerfile",
        "{workspaceRoot}/.dockerignore",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml",
        "{workspaceRoot}/submodules/otel-arrow/**/*"
      ],
      "outputs": [
        "{workspaceRoot}/target/images/arrowcol-dataflow-rust-load.txt"
      ],
      "options": {
        "file": "{absProjectRoot}/Dockerfile",
        "context": "{absWorkspaceRoot}",
        "image": "ghcr.io/mdrakiburrahman/rust-playground/arrowcol-dataflow-rust",
        "tags": ["dev"],
        "buildArgs": ["VCS_REF={gitSha}"],
        "requireCleanWorktree": true,
        "platforms": ["linux/amd64"],
        "output": "load",
        "manifestFile": "{absWorkspaceRoot}/target/images/arrowcol-dataflow-rust-load.txt"
      },
      "configurations": {
        "ci-verify": {
          "cacheFrom": ["type=gha,version=2,scope={projectName}-image"],
          "cacheTo": ["type=gha,version=2,scope={projectName}-image,mode=max"]
        }
      }
    },
    "image-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["image"],
      "options": {
        "command": "bash projects/arrowcol-dataflow-rust/scripts/image-smoke.sh",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "publish": {
      "executor": "rust-playground-build:docker-build",
      "cache": false,
      "inputs": [
        "default",
        "^default",
        "{projectRoot}/Dockerfile",
        "{workspaceRoot}/.dockerignore",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml",
        "{workspaceRoot}/submodules/otel-arrow/**/*"
      ],
      "outputs": [
        "{workspaceRoot}/target/images/arrowcol-dataflow-rust-publish.txt"
      ],
      "options": {
        "file": "{absProjectRoot}/Dockerfile",
        "context": "{absWorkspaceRoot}",
        "image": "ghcr.io/mdrakiburrahman/rust-playground/arrowcol-dataflow-rust",
        "tags": ["{gitBranchTag}", "sha-{gitSha}"],
        "immutableTags": ["sha-{gitSha}"],
        "requireCleanWorktree": true,
        "buildArgs": ["VCS_REF={gitSha}"],
        "platforms": ["linux/amd64"],
        "output": "push",
        "manifestFile": "{absWorkspaceRoot}/target/images/arrowcol-dataflow-rust-publish.txt"
      },
      "configurations": {
        "main": {
          "tags": ["{gitBranchTag}", "sha-{gitSha}", "latest"]
        }
      }
    },
    "smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "projects/arrowcol-dataflow-rust/scripts/smoke.sh",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "live-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "projects/arrowcol-dataflow-rust/scripts/live-e2e.sh",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt --package arrowcol-dataflow-rust"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt --package arrowcol-dataflow-rust -- --check"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy --locked --package arrowcol-dataflow-rust --all-targets -- -D warnings"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --locked --package arrowcol-dataflow-rust"
      }
    },
    "doc": {
      "executor": "nx:run-commands",
      "options": {
        "command": "RUSTDOCFLAGS='-D warnings' cargo doc --locked --package arrowcol-dataflow-rust --no-deps"
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "config-check",
        "smoke",
        "format-check",
        "lint",
        "test",
        "doc"
      ],
      "options": {
        "commands": []
      }
    }
  },
  "tags": ["scope:rust", "type:application", "type:runtime-image"]
}
