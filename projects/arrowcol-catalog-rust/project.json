{
  "name": "arrowcol-catalog-rust",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "projects/arrowcol-catalog-rust/src",
  "implicitDependencies": ["arrowcol-catalog", "arrowcol-catalog-client", "arrow-deltalake", "arrowcol-protocol", "arrowcol-props", "arrowcol-sparksql"],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/rustfmt.toml"
    ]
  },
  "metadata": {
    "description": "Rust-only schema catalog service and CES validation endpoint."
  },
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/clean.ts projects/arrowcol-catalog-rust",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "format": {"executor": "nx:run-commands", "cache": false, "options": {"command": "cargo fmt --package arrowcol-catalog-rust"}},
    "format-check": {"executor": "nx:run-commands", "options": {"command": "cargo fmt --package arrowcol-catalog-rust -- --check"}},
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["default", "^default"],
      "options": {"command": "cargo clippy --locked --package arrowcol-catalog-rust --all-targets --all-features -- -D warnings"}
    },
    "build": {"executor": "nx:run-commands", "cache": false, "options": {"command": "cargo build --locked --package arrowcol-catalog-rust --all-features"}},
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["default", "^default"],
      "options": {"command": "cargo test --locked --package arrowcol-catalog-rust --all-features"}
    },
    "run": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {"command": "cargo run --locked --package arrowcol-catalog-rust --", "forwardAllArgs": true}
    },
    "image": {
      "executor": "rust-playground-build:docker-build",
      "cache": false,
      "inputs": [
        "default",
        "^default",
        "{projectRoot}/Dockerfile",
        "{workspaceRoot}/.dockerignore",
        "{workspaceRoot}/infra/docker/install-azure-cli.sh",
        "{workspaceRoot}/submodules/otel-arrow/**/*"
      ],
      "outputs": ["{workspaceRoot}/target/images/arrowcol-catalog-rust-load.txt"],
      "options": {
        "file": "{absProjectRoot}/Dockerfile",
        "context": "{absWorkspaceRoot}",
        "image": "ghcr.io/mdrakiburrahman/rust-playground/arrowcol-catalog-rust",
        "tags": ["dev"],
        "buildArgs": ["VCS_REF={gitSha}"],
        "requireCleanWorktree": true,
        "platforms": ["linux/amd64"],
        "output": "load",
        "manifestFile": "{absWorkspaceRoot}/target/images/arrowcol-catalog-rust-load.txt"
      },
      "configurations": {
        "ci-verify": {
          "cacheFrom": ["type=gha,version=2,scope={projectName}-image"],
          "cacheTo": ["type=gha,version=2,scope={projectName}-image,mode=max"]
        }
      }
    },
    "image-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["image"],
      "options": {
        "commands": [
          "docker run --rm --platform linux/amd64 ghcr.io/mdrakiburrahman/rust-playground/arrowcol-catalog-rust:dev --help",
          "docker run --rm --platform linux/amd64 --entrypoint sh ghcr.io/mdrakiburrahman/rust-playground/arrowcol-catalog-rust:dev -c 'test \"$(id -u)\" = 10001 && test \"$(stat -c %a:%u \"$AZURE_CONFIG_DIR\")\" = 700:10001 && test -z \"$(ls -A \"$AZURE_CONFIG_DIR\")\" && az version >/dev/null && test -x /usr/bin/tini'",
          "set -eu; container=$(docker run --detach --rm --platform linux/amd64 --stop-signal SIGINT --stop-timeout 10 ghcr.io/mdrakiburrahman/rust-playground/arrowcol-catalog-rust:dev); trap 'docker stop \"$container\" >/dev/null' EXIT; for attempt in $(seq 1 30); do if docker exec \"$container\" /usr/local/bin/arrowcol-catalog-rust --healthcheck; then exit 0; fi; sleep 1; done; docker logs \"$container\"; exit 1"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    },
    "publish": {
      "executor": "rust-playground-build:docker-build",
      "cache": false,
      "inputs": [
        "default",
        "^default",
        "{projectRoot}/Dockerfile",
        "{workspaceRoot}/.dockerignore",
        "{workspaceRoot}/infra/docker/install-azure-cli.sh",
        "{workspaceRoot}/submodules/otel-arrow/**/*"
      ],
      "outputs": ["{workspaceRoot}/target/images/arrowcol-catalog-rust-publish.txt"],
      "options": {
        "file": "{absProjectRoot}/Dockerfile",
        "context": "{absWorkspaceRoot}",
        "image": "ghcr.io/mdrakiburrahman/rust-playground/arrowcol-catalog-rust",
        "tags": ["{gitBranchTag}", "sha-{gitSha}"],
        "immutableTags": ["sha-{gitSha}"],
        "requireCleanWorktree": true,
        "buildArgs": ["VCS_REF={gitSha}"],
        "platforms": ["linux/amd64"],
        "output": "push",
        "manifestFile": "{absWorkspaceRoot}/target/images/arrowcol-catalog-rust-publish.txt"
      },
      "configurations": {
        "main": {
          "tags": ["{gitBranchTag}", "sha-{gitSha}", "latest"]
        }
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["format-check", "lint", "build", "test"],
      "options": {"commands": []}
    }
  },
  "tags": ["scope:rust", "type:application", "type:runtime-image"]
}
