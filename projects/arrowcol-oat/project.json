{
  "name": "arrowcol-oat",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "projects/arrowcol-oat",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {"command": "npx --no-install tsx --test projects/arrowcol-oat/launch.test.ts"}
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {"command": "npx --no-install tsc --project projects/arrowcol-oat/tsconfig.json"}
    },
    "launch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx projects/arrowcol-oat/launch.ts",
        "forwardAllArgs": true
      }
    }
  }
}
