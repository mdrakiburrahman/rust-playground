{
  "name": "otelcol-rust",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["otel-deltalake-exporter"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo build --locked --package otelcol-rust"
      }
    },
    "config-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "target/debug/otelcol-rust --validate-and-exit --config projects/otelcol-rust/config.yaml"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "target/debug/otelcol-rust --num-cores 2 --config projects/otelcol-rust/config.yaml",
        "forwardAllArgs": true
      }
    },
    "image": {
      "executor": "rust-playground-build:docker-build",
      "cache": false,
      "options": {
        "file": "{absProjectRoot}/Dockerfile",
        "context": "{absWorkspaceRoot}",
        "image": "ghcr.io/mdrakiburrahman/rust-playground/otelcol-rust",
        "tags": ["dev"],
        "platforms": ["linux/amd64"],
        "output": "load"
      }
    },
    "image-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["image"],
      "options": {
        "command": "docker run --rm ghcr.io/mdrakiburrahman/rust-playground/otelcol-rust:dev --validate-and-exit --config /etc/otelcol-rust/config.yaml"
      }
    },
    "format": {"executor": "nx:run-commands", "options": {"command": "cargo fmt --package otelcol-rust"}},
    "format-check": {"executor": "nx:run-commands", "options": {"command": "cargo fmt --package otelcol-rust -- --check"}},
    "lint": {"executor": "nx:run-commands", "options": {"command": "cargo clippy --locked --package otelcol-rust --all-targets -- -D warnings"}},
    "test": {"executor": "nx:run-commands", "options": {"command": "cargo test --locked --package otelcol-rust"}},
    "verify": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["config-check", "format-check", "lint", "test"],
      "options": {"commands": []}
    }
  },
  "tags": ["scope:rust", "type:application"]
}
