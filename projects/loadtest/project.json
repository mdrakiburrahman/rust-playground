{
  "name": "loadtest",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": [
    "arrowcol-rust",
    "arrowcol-dataflow-rust",
    "arrowcol-router-rust",
    "arrowcol-infra",
    "arrowcol-sdk-gen",
    "kusto-explorer",
    "kusto-bridge",
    "arrow-tenant-stream",
    "delta-maintenance"
  ],
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt --package delta-inspect --package arrowcol-loadgen"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo fmt --package delta-inspect --package arrowcol-loadgen -- --check",
          "cargo clippy --locked --package delta-inspect --all-targets -- -D warnings",
          "cargo clippy --locked --package arrowcol-loadgen --all-targets -- -D warnings",
          "npx --no-install tsc --project projects/loadtest/tsconfig.json"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo test --locked --package delta-inspect",
          "cargo test --locked --package arrowcol-loadgen",
          "npx --no-install tsx --test projects/loadtest/test/*.test.ts",
          "npx --no-install tsx projects/loadtest/src/compose-check.ts"
        ],
        "parallel": false
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "npx --no-install tsx projects/loadtest/src/main.ts",
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "reader-build",
        {
          "projects": [
            "arrowcol-rust",
            "arrowcol-dataflow-rust",
            "arrowcol-router-rust",
            "kusto-explorer",
            "kusto-bridge",
            "arrow-tenant-stream",
            "delta-maintenance"
          ],
          "target": "image"
        }
      ],
      "options": {
        "commands": []
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "lint",
        "test",
        "e2e"
      ],
      "options": {
        "commands": []
      }
    },
    "reader-build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["lint", "test"],
      "options": {
        "command": "projects/loadtest/scripts/build-reader-bundle.sh"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "build"
      ],
      "options": {
        "commands": [
          "npx --no-install tsx projects/loadtest/src/main.ts --warmup 5s --measure 30s --batch-rows 1024 --validate",
          "npx --no-install tsx projects/loadtest/src/main.ts --warmup 5s --measure 60s --batch-rows 1024 --validate --quiver --crash-after 15s"
        ],
        "parallel": false,
        "forwardAllArgs": false
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/clean.ts projects/loadtest",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    }
  },
  "tags": [
    "scope:rust",
    "type:e2e"
  ]
}
