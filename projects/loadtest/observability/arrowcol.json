{
  "uid": "arrowcol",
  "title": "ArrowCol: Dataflow collector",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rows ingested / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(arrowcol_received_rows_total[30s])",
          "legendFormat": "dataflow"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Rows exported / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(arrowcol_delta_rows_total[30s])",
          "legendFormat": "dataflow"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU (cores)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service=\"dataflow-1\"}[30s]))",
          "legendFormat": "dataflow"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "RAM",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(container_memory_working_set_bytes{container_label_com_docker_compose_service=\"dataflow-1\"})",
          "legendFormat": "dataflow"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Durable-buffer backlog (not yet in Delta; --quiver)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "arrowcol_dataflow_durable_backlog_batches",
          "legendFormat": "batches"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Durable-buffer disk (--quiver)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "arrowcol_dataflow_durable_backlog_bytes",
          "legendFormat": "backlog"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Durable-buffer admission / release (--quiver)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(arrowcol_dataflow_durable_admitted_batches_total[30s])",
          "legendFormat": "persisted"
        },
        {
          "refId": "B",
          "expr": "rate(arrowcol_dataflow_durable_released_batches_total[30s])",
          "legendFormat": "drained"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Replayed from durable buffer after crash (--crash-after)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "arrowcol_dataflow_replayed_batches_total",
          "legendFormat": "replay attempts"
        },
        {
          "refId": "B",
          "expr": "arrowcol_dataflow_rebound_batches_total",
          "legendFormat": "lease rebinds"
        }
      ]
    }
  ]
}
