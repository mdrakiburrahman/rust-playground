# Copy to private repo-bootstrapper sync/rust-playground/.env. Never commit values.
# Local remains the default. --mode azure selects ADLS and Azure Kusto together.
ARROWCOL_MODE=local
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rust-playground
AZURE_LOCATION=eastus2
# Blank names are deterministically derived from the private subscription.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=arrowcol
AZURE_STORAGE_CHECKPOINT_CONTAINER=checkpoints
AZURE_KUSTO_CLUSTER=
AZURE_KUSTO_DATABASE=arrowcol
AZURE_KUSTO_IDENTITY_NAME=arrowcol-kusto-reader
AZURE_KUSTO_SKU=Standard_E4ads_v5
AZURE_KUSTO_MIN_INSTANCES=2
AZURE_KUSTO_MAX_INSTANCES=4
AZURE_KUSTO_QAP_HOT_DAYS=7
# Optional JSON object of extra cluster tags required by tenant Azure Policy, e.g.
# {"NRMS.KustoPlatform.Classification.1P":"Corp"} in the Microsoft corp tenant.
AZURE_KUSTO_CLUSTER_TAGS=
# Optional existing Entra principal, otherwise inferred from signed-in CLI token.
AZURE_OPERATOR_OBJECT_ID=
AZURE_OPERATOR_TYPE=User
# Only for an already signed-in App operator; distinct from its object ID.
AZURE_OPERATOR_APPLICATION_ID=
# Generated .env.azure contains endpoints/roots; do not commit or log it.
